# Copy to .env (ignored), then set your own local password. No real data is bundled.
DEMANDIQ_ENVIRONMENT=development
DEMANDIQ_POSTGRES_HOST=127.0.0.1
DEMANDIQ_POSTGRES_PORT=55432
DEMANDIQ_POSTGRES_DB=demandiq
DEMANDIQ_POSTGRES_USER=demandiq
DEMANDIQ_POSTGRES_PASSWORD=
# Optional full PostgreSQL URL overrides the individual connection settings.
# DEMANDIQ_DATABASE_URL=
DEMANDIQ_DATA_DIR=data/raw
DEMANDIQ_ARCHIVE_DIR=data/archive
DEMANDIQ_LOG_LEVEL=INFO
DEMANDIQ_SOURCE=m5
# Explicit selection is required for ingestion. Lists are JSON arrays.
DEMANDIQ_M5_STORE_IDS=[]
DEMANDIQ_M5_ITEM_IDS=[]
DEMANDIQ_M5_DEPARTMENT_IDS=[]
DEMANDIQ_M5_CATEGORY_IDS=[]
# Set both dates when choosing the subset, or pass them on the CLI.
# DEMANDIQ_M5_START_DATE=YYYY-MM-DD
# DEMANDIQ_M5_END_DATE=YYYY-MM-DD


# Forecast artifacts only; methodological settings are versioned in forecasting/protocol.py.
DEMANDIQ_FORECAST_ARTIFACTS_DIR=artifacts/forecasting
